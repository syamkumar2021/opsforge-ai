# ======================
# Application
# ======================
APP_NAME=OpsForge AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-very-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================
# PostgreSQL
# ======================
POSTGRES_USER=opsforge
POSTGRES_PASSWORD=opsforge_secret
POSTGRES_DB=opsforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opsforge:opsforge_secret@postgres:5432/opsforge

# ======================
# Kafka (KRaft)
# ======================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_EXCEPTIONS=ops.exceptions
KAFKA_TOPIC_DLQ=ops.exceptions.dlq
KAFKA_TOPIC_NOTIFICATIONS=ops.notifications
KAFKA_CONSUMER_GROUP=opsforge-workers
KAFKA_AUTO_OFFSET_RESET=earliest

# ======================
# LLM (OpenRouter - OpenAI compatible)
# ======================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=qwen/qwen-2.5-72b-instruct
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ======================
# Playwright / Browser Agent
# ======================
PLAYWRIGHT_HEADLESS=true
VENDOR_PORTAL_URL=https://example-vendor-portal.com
CARRIER_TRACKING_URL=https://www.ups.com/track


LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=OpsForge-AI
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ======================
# MuleSoft (currently mocked – real values for future)
# ======================
# MULESOFT_BASE_URL=https://your-anypoint-instance.cloudhub.io
# MULESOFT_CLIENT_ID=your-client-id
# MULESOFT_CLIENT_SECRET=your-client-secret
# MULESOFT_TOKEN_URL=https://your-anypoint-instance.cloudhub.io/oauth/token

# ======================
# email settings for testing with Mailpit
# ======================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=opsforge@local.test
NOTIFY_EMAIL_TO=ops-team@company.com
SMTP_TLS=false